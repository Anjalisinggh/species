# From Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Robinhood Chain (optional). Leave empty until the registry contract is deployed: see chain/README.md
NEXT_PUBLIC_CHAIN=testnet
NEXT_PUBLIC_REGISTRY_ADDRESS=
# Server-only signing key for on-chain attestations. Never prefix with NEXT_PUBLIC_. Holds no funds.
ATTESTER_PRIVATE_KEY=

# Launch settings
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional privacy-friendly analytics (Plausible, cookie-free). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
